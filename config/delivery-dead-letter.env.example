# Explicit manual local FAILED -> DEAD_LETTER only. No provider lookup, retry or dispatch.
# Both this switch and the existing delivery-journal read switch must be true.
MOP_DELIVERY_DEAD_LETTER_ENABLED=false
# Independent private tenant UUID -> resource-pool UUID arrays. No automatic read-to-write grant.
# Effective scope is the intersection with MOP_DELIVERY_JOURNAL_READ_POOLS.
MOP_DELIVERY_DEAD_LETTER_POOLS=
