# Read-only local V50 history; no provider queries, sends, retries or delivery verification.
MOP_DELIVERY_JOURNAL_READ_ENABLED=false
# Private JSON keyed by tenant UUID; values are explicit resource-pool UUID arrays.
# No default/all-pool scope. Empty or absent scope is unconfigured, not an empty successful ledger.
# Current padmin role plus ticket_notes:read_internal and audit:read are still required.
MOP_DELIVERY_JOURNAL_READ_POOLS=
