# Disabled by default. No migration, source change, collection or dispatch is performed at startup.
MOP_MONITORING_MAPPING_ENABLED=false
# Separate explicit one-event source read and raw-only save; no collector or dispatch.
MOP_MONITORING_MAPPING_CAPTURE_ENABLED=false
# Private JSON keyed by tenant UUID: reference, pools (UUID array), reviewers (UUID array),
# self_approval_allowed (explicit boolean), verification_ttl_seconds (explicit 1..86400).
# Missing values remain unconfigured. No example customer/tenant or automatic approval.
MOP_MONITORING_MAPPING_POLICIES=
# Private JSON keyed by pool UUID: provider=ZABBIX_7, reference, endpoint (bound loopback URL),
# token_env (environment variable NAME only), tags={pool,tenant,asset} (explicit own-host tag keys).
# Endpoint/token reference/tags may be null until supplied. No secret values in this file.
# Change reference when the source identity/credential authority changes.
MOP_MONITORING_MAPPING_SOURCES=
# Read-only designated isolated PostgreSQL readiness checks, no DDL or synthetic writes.
MOP_RUN_MONITORING_MAPPING_PG_TESTS=false
MOP_MONITORING_MAPPING_TEST_JDBC_URL=
MOP_MONITORING_MAPPING_TEST_PASSWORD=
# Only for separately approved isolated source-storage integration tests; no default customer namespace.
MOP_MONITORING_TEST_TENANT_ID=
MOP_MONITORING_TEST_OTHER_TENANT_ID=
