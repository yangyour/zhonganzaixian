# Disabled until explicit per-tenant service/asset mapping is supplied privately.
MOP_SERVICE_OBSERVATIONS_ENABLED=false
MOP_SERVICE_DEFINITIONS=
# JSON object: canonical tenant UUID -> array of service objects.
# Each service requires id (UUID), name, asset_ids (1..100 unique UUIDs),
# failure_mode (ANY_ASSET_UNAVAILABLE or ALL_ASSETS_UNAVAILABLE),
# maintenance_mode (ANY_ASSET_APPROVED or ALL_ASSETS_APPROVED),
# target_pct (null if unconfirmed; otherwise 0..100, up to 4 decimal places).
# No default mapping, target, policy, positive-health evidence or customer acceptance is inferred.
# Read-only existing PostgreSQL sources; no migrations, worker activation or external collection.
