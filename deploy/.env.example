# 本地应用通过SSH连接指定服务器的真实测试组件。
# 秘密从被Git忽略的deploy/private/runtime.json注入，以下仅为无密样例。
MOP_API_PORT=8080
MOP_WEB_PORT=5173
MOP_MODE=remote_test
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:15432/mop_test
SPRING_DATASOURCE_USERNAME=mop_test_runtime
MOP_MIGRATION_USERNAME=mop_test_migrator
MOP_OIDC_ISSUER=http://127.0.0.1:18110/realms/mop-test
MOP_OIDC_CLIENT_ID=mop-web

# 不在此处填写密码/client secret。消息、监控、存储是否集成见组件清单。
# 测试环境接入不表示客户生产配置已批准；生产模式仍拒绝启动。

# Optional owner-approved OSS provider; credentials are injected privately, never copied here.
# Complete absence preserves the legacy MinIO path. Partial/disabled OSS never falls back.
# OBJECT_STORAGE_ENABLED=True
# OBJECT_STORAGE_PROVIDER=oss
# OBJECT_STORAGE_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OBJECT_STORAGE_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OBJECT_STORAGE_REGION=cn-beijing
# OBJECT_STORAGE_BUCKET=<approved-bucket>
# OBJECT_STORAGE_ACCESS_KEY=<private-injection>
# OBJECT_STORAGE_SECRET_KEY=<private-injection>
# OBJECT_STORAGE_SECURITY_TOKEN=<optional-private-STS-token>
# OBJECT_STORAGE_PRESIGN_EXPIRES=3600
# MOP_OBJECT_STORAGE_PREFIX=mop-niko-test/<stable-deployment-uuid>/
# This does not enable presigned downloads or replace platform authorization grants.
# Existing media/format allowlists and explicit worker opt-ins remain separately required.
