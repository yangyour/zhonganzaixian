# Optional, operator-selected local tools. Empty values do not pass validation.
# Reviewed test release: https://github.com/prometheus/prometheus/releases/tag/v3.15.1
MOP_PROMTOOL_PATH=
# Used only by opt-in local synthetic integration tests, not application startup.
MOP_PROMETHEUS_BIN=
# Explicit file discovery refresh period, integer seconds in [1, 300].
MOP_FILE_SD_REFRESH_SECONDS=
