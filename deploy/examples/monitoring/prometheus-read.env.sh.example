# Disabled by default. Fill and review tenant-scoped targets and sources before activation.
# Registry visibility, direct probing and Prometheus reads have separate switches.
export MOP_MONITORING_PRESET_REGISTRY_ENABLED=false
export MOP_MONITORING_PRESET_TEST_ENABLED=false
export MOP_MONITORING_PRESET_TARGETS='{"version":1,"targets":[]}'
export MOP_MONITORING_PRESET_ALLOWED_ENDPOINTS='[]'
export MOP_MONITORING_PRESET_ALLOWED_TARGETS='[]'
export MOP_MONITORING_PROMETHEUS_READ_ENABLED=false
export MOP_MONITORING_PROMETHEUS_SOURCES='{"version":1,"sources":[]}'
export MOP_MONITORING_PROMETHEUS_ALLOWED_ENDPOINTS='[]'
# For read-only operation, explicitly enable REGISTRY and PROMETHEUS_READ only.
# Leave PRESET_TEST=false and its destination allowlists empty unless separately approved.
# Source endpoints must be exact http(s)://IPv4:port/api/v1/query values.
# This template creates no account, credential, authorization, collector or deployment.
