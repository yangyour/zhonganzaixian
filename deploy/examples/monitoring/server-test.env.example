# Operator-managed startup configuration. Never put credentials in this file.
# Default false. Enable only after validating explicit target and downstream scope.
MOP_MONITORING_PRESET_TEST_ENABLED=false
# Full v1 config JSON from monitoring_presets.py / onboarding workspace.
MOP_MONITORING_PRESET_TARGETS=
# JSON arrays of exact URLs / downstream values from that configuration; no CIDRs or wildcards.
MOP_MONITORING_PRESET_ALLOWED_ENDPOINTS=[]
MOP_MONITORING_PRESET_ALLOWED_TARGETS=[]
# These settings enable single probes only, not collection, registration writes or deployment.
