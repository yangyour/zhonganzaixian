# Optional local PDF DRAFT renderer. Not publication, customer delivery or PDF/UA certification.
# Enable only with explicitly approved standalone OTF/TTF font files and matching SHA-256.
# No implicit OS font discovery, TTC face guessing, network resources or persistent output.
MOP_REPORT_PDF_PREVIEW_ENABLED=false
MOP_REPORT_PDF_FONT_PATH=
MOP_REPORT_PDF_FONT_SHA256=
# Optional explicit fallback for glyphs absent from the primary CJK font (for example emoji).
MOP_REPORT_PDF_FALLBACK_FONT_PATH=
MOP_REPORT_PDF_FALLBACK_FONT_SHA256=
