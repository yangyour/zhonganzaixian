# java -jar mop-worker-0.1.0-SNAPSHOT.jar --sla-reminders
# Records durable notification intents only. No recipient/provider is guessed, no actual send occurs.
SPRING_PROFILES_ACTIVE=remote_test
MOP_TICKET_LIFECYCLE_ENABLED=false
MOP_SLA_REMINDER_ENABLED=false
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=mop_test_runtime
SPRING_DATASOURCE_PASSWORD=
# Explicit operational inputs: lease 5..300 seconds; attempts 1..100; idle poll 100..60000 ms.
MOP_SLA_REMINDER_LEASE_SECONDS=
MOP_SLA_REMINDER_MAX_ATTEMPTS=
MOP_SLA_REMINDER_POLL_MILLIS=
# Business tick interval and progress nodes must be read from the verified fixed registry keys.
