# Explicit independent mode: java -jar mop-worker-0.1.0-SNAPSHOT.jar --ticket-autoclose
# No migration, account creation, notification or credentials are supplied by this example.
SPRING_PROFILES_ACTIVE=remote_test
MOP_TICKET_LIFECYCLE_ENABLED=false
MOP_TICKET_AUTOCLOSE_ENABLED=false
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=mop_test_runtime
SPRING_DATASOURCE_PASSWORD=
# Required technical limits, no implicit fallback: lease 5..300 seconds; attempts 1..100; poll 100..60000 ms.
MOP_TICKET_AUTOCLOSE_LEASE_SECONDS=
MOP_TICKET_AUTOCLOSE_MAX_ATTEMPTS=
MOP_TICKET_AUTOCLOSE_POLL_MILLIS=
