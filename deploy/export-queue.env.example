# Only private project test configuration. Never include actual passwords in Git.
SPRING_PROFILES_ACTIVE=remote_test
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:12060/mop_test
SPRING_DATASOURCE_USERNAME=mop_test_runtime
SPRING_DATASOURCE_PASSWORD=
MOP_EXPORT_PREPARATION_QUEUE_ENABLED=false
MOP_EXPORT_PREPARATION_WORKER_ID=export-preparation-queue
MOP_EXPORT_PREPARATION_LEASE_MILLIS=30000
# Explicit UTC cutover with seconds or exactly 3 fractional digits. Persist the SAME value on restarts.
# Only API-receipted jobs created at or after this time and without prepared bytes are eligible.
MOP_EXPORT_PREPARATION_ACCEPTED_AFTER=
