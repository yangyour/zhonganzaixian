# Copy into ignored private configuration. Empty credentials deliberately leave storage unavailable.
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PHOTO_BUCKET=mop-test-photos
OBJECT_STORAGE_PHOTO_ACCESS_KEY=
OBJECT_STORAGE_PHOTO_SECRET_KEY=
OBJECT_STORAGE_IMPORT_BUCKET=mop-test-asset-imports
OBJECT_STORAGE_IMPORT_ACCESS_KEY=
OBJECT_STORAGE_IMPORT_SECRET_KEY=
MOP_PHOTO_ALLOWED_MEDIA_TYPES=image/jpeg,image/png
MOP_IMPORT_ALLOWED_FORMATS=CSV,XLSX

# Explicit publication of an already prepared export; independent credentials, no automatic background publication.
MOP_EXPORT_PUBLICATION_ENABLED=false
OBJECT_STORAGE_EXPORT_BUCKET=mop-test-asset-exports
OBJECT_STORAGE_EXPORT_ACCESS_KEY=
OBJECT_STORAGE_EXPORT_SECRET_KEY=
# Private Base64 encoding of 32-64 random bytes. Keep stable across API restarts; never put the actual key in Git.
MOP_EXPORT_DOWNLOAD_SIGNING_KEY=

# OSS is the other explicit provider; use the approved OSS scope and actual private credentials.
# OBJECT_STORAGE_PROVIDER=oss
# OBJECT_STORAGE_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OBJECT_STORAGE_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OBJECT_STORAGE_REGION=cn-beijing
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_PRESIGN_EXPIRES=3600
# MOP_OBJECT_STORAGE_PREFIX=mop-niko-test/<deployment-uuid>/

# Apply V31 explicitly before enabling own export inbox; API only, no external delivery.
MOP_EXPORT_INBOX_ENABLED=false
