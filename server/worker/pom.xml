<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>cn.mop</groupId><artifactId>mop-platform</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>mop-worker</artifactId>
  <dependencies>
    <dependency><groupId>cn.mop</groupId><artifactId>mop-domain</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>cn.mop</groupId><artifactId>mop-persistence</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>cn.mop</groupId><artifactId>mop-adapters</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
    <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><executions><execution>
      <id>import-plain-jar</id><phase>package</phase><goals><goal>jar</goal></goals><configuration><classifier>imports</classifier><forceCreation>true</forceCreation></configuration>
    </execution><execution><id>contact-import-plain-jar</id><phase>package</phase><goals><goal>jar</goal></goals><configuration><classifier>contact-imports</classifier><forceCreation>true</forceCreation></configuration></execution></executions></plugin>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><executions>
      <execution><id>repackage</id><goals><goal>repackage</goal></goals><configuration><mainClass>cn.mop.worker.WorkerApplication</mainClass></configuration></execution>
      <execution><id>repackage-imports</id><goals><goal>repackage</goal></goals><configuration><classifier>imports</classifier><mainClass>cn.mop.importworker.AssetImportWorkerApplication</mainClass></configuration></execution>
      <execution><id>repackage-contact-imports</id><goals><goal>repackage</goal></goals><configuration><classifier>contact-imports</classifier><mainClass>cn.mop.contactworker.ContactImportWorkerApplication</mainClass></configuration></execution>
    </executions></plugin>
  </plugins></build>
</project>
